{
  "name": "orqenix-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Production-grade primary-agent orchestration engine",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Milo Nguyen",
  "repository": {
    "type": "git",
    "url": "https://github.com/milosaysyolo/Orqenix.git"
  },
  "homepage": "https://orqenix.dev",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "lockfile:check": "node scripts/release/check-lockfile-drift.mjs",
    "lockfile:fix": "pnpm install --lockfile-only && node scripts/release/check-lockfile-drift.mjs",
    "lockfile:sync": "bash scripts/release/sync-lockfile.sh",
    "lockfile:verify-allowlist": "node scripts/release/verify-only-built-deps.mjs",
    "lockfile:verify-diff": "node scripts/release/verify-lockfile-diff-scope.mjs",
    "ci:get-pro-ref": "node scripts/ci/get-pro-ref.mjs",
    "ci:validate-refs": "node scripts/ci/get-pro-ref.mjs --validate",
    "ci:align-pro-checkout": "node scripts/ci/align-pro-checkout.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "smoke": "tsx scripts/smoke/run.ts",
    "bundle:check": "pnpm build && node scripts/check-bundle-size.mjs",
    "verify-phase-5": "tsx scripts/verify-phase-5.ts",
    "verify-phase-5:quick": "tsx scripts/verify-phase-5.ts --quick",
    "verify-phase-5:report": "tsx scripts/verify-phase-5.ts --report",
    "pre-phase-5-check": "tsx scripts/pre-phase-5-check.ts",
    "verify-phase-4-stubs": "tsx scripts/verify-phase-4-stubs.ts",
    "test:charter": "tsx scripts/gates/run-all.ts",
    "test:charter:G1": "tsx scripts/gates/G1-phase4-stubs-wired.ts",
    "scaffold:create": "tsx scripts/scaffold/create.ts",
    "bench:phase-4": "pnpm --filter @orqenix/bench bench:phase-4",
    "bench:runner": "tsx bench/runner.ts",
    "audit:check": "tsx scripts/audit-precheck.ts",
    "bundlesize": "tsx scripts/check-bundlesize.ts",
    "charter": "bash charter/run.sh",
    "charter:phase-4": "pnpm audit:check && tsx scripts/run-charter.ts",
    "charter:g17": "echo 'detach round-trip placeholder' && exit 0",
    "charter:g18": "echo 'audit tamper placeholder' && exit 0",
    "charter:docker": "docker build -t orqenix-charter -f charter/Dockerfile . && docker run --rm -v $PWD:/repo orqenix-charter",
    "integration": "pnpm --filter @orqenix/integration test",
    "smoke:cross-repo": "bash smoke/cross-repo-smoke.sh",
    "smoke:cross-repo:windows": "pwsh ./smoke/cross-repo-smoke.ps1",
    "lint": "pnpm -r --filter=\"./packages/*\" lint",
    "clean": "pnpm -r --filter=\"./packages/*\" clean && rm -rf node_modules",
    "pre-publish-check": "tsx scripts/pre-publish-check.ts",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && pnpm test && pnpm verify-phase-5 && changeset publish",
    "ci:publish": "pnpm build && changeset publish",
    "release:dry-run": "pnpm -r exec npm pack --dry-run",
    "release:propose": "tsx scripts/release-propose.ts",
    "fix:deps": "node scripts/verify/fix-dep-versions.mjs",
    "check:deps": "node scripts/verify/check-dep-versions.mjs",
    "check:native": "node scripts/verify/check-native-bindings.mjs",
    "rebuild:native": "node scripts/verify/rebuild-native.mjs",
    "verify": "node scripts/verify/verify-phase-8.mjs",
    "verify:fast": "node scripts/verify/verify-phase-8.mjs --no-build",
    "verify:phase-8-only": "node scripts/verify/verify-phase-8.mjs --phase-8-only",
    "test:phase-8": "node scripts/verify/test-gate.mjs --phase-8-only",
    "test:all": "node scripts/verify/test-gate.mjs --all",
    "merge-verify": "node scripts/merge-verify/verify-all-phases.mjs",
    "merge-verify:conflicts": "node scripts/merge-verify/scan-merge-conflicts.mjs",
    "postinstall": "node scripts/verify/check-native-bindings.mjs --auto-rebuild || true",
    "cleanup": "node scripts/cleanup/cleanup.mjs",
    "cleanup:dry-run": "node scripts/cleanup/cleanup.mjs --dry-run",
    "cleanup:auto": "node scripts/cleanup/cleanup.mjs --auto-confirm",
    "cleanup:full": "node scripts/cleanup/cleanup.mjs --auto-confirm --regen-lock",
    "scan:cruft": "node scripts/cleanup/scan-cruft.mjs",
    "scan:lockfile": "node scripts/cleanup/lockfile-audit.mjs",
    "scan:workspace": "node scripts/cleanup/verify-workspace-integrity.mjs",
    "test:cleanup": "node scripts/cleanup/cleanup.test.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@mongodb-js/zstd",
      "better-sqlite3",
      "esbuild",
      "@swc/core",
      "sharp"
    ],
    "overrides": {
      "protobufjs": "^7.5.8",
      "tmp@<0.2.6": ">=0.2.6",
      "better-sqlite3": "^12.0.0",
      "prebuild-install": "^7.1.2"
    },
    "patchedDependencies": {}
  },
  "devDependencies": {
    "@changesets/cli": "2.27.10",
    "@changesets/changelog-github": "0.5.0",
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "turbo": "^2.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "eslint": "^9.15.0",
    "yaml": "^2.5.0"
  }
}

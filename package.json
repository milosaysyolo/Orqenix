{
  "name": "orqenix-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Production-grade primary-agent orchestration engine",
  "license": "Apache-2.0",
  "author": "Milo Nguyen",
  "repository": {
    "type": "git",
    "url": "https://github.com/milosaysyolo/Orqenix.git"
  },
  "homepage": "https://orqenix.dev",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "lockfile:check": "node scripts/release/check-lockfile-drift.mjs",
    "lockfile:fix": "pnpm install --lockfile-only && node scripts/release/check-lockfile-drift.mjs",
    "lockfile:verify-allowlist": "node scripts/release/verify-only-built-deps.mjs",
    "lockfile:verify-diff": "node scripts/release/verify-lockfile-diff-scope.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "smoke": "tsx scripts/smoke/run.ts",
    "bundle:check": "pnpm build && node scripts/check-bundle-size.mjs",
    "verify-phase-5": "tsx scripts/verify-phase-5.ts",
    "verify-phase-5:quick": "tsx scripts/verify-phase-5.ts --quick",
    "verify-phase-5:report": "tsx scripts/verify-phase-5.ts --report",
    "pre-phase-5-check": "tsx scripts/pre-phase-5-check.ts",
    "verify-phase-4-stubs": "tsx scripts/verify-phase-4-stubs.ts",
    "test:charter": "tsx scripts/gates/run-all.ts",
    "test:charter:G1": "tsx scripts/gates/G1-phase4-stubs-wired.ts",
    "scaffold:create": "tsx scripts/scaffold/create.ts",
    "bench:phase-4": "pnpm --filter @orqenix/bench bench:phase-4",
    "bench:runner": "tsx bench/runner.ts",
    "audit:check": "tsx scripts/audit-precheck.ts",
    "bundlesize": "tsx scripts/check-bundlesize.ts",
    "charter": "bash charter/run.sh",
    "charter:phase-4": "pnpm audit:check && tsx scripts/run-charter.ts",
    "charter:g17": "echo 'detach round-trip placeholder' && exit 0",
    "charter:g18": "echo 'audit tamper placeholder' && exit 0",
    "charter:docker": "docker build -t orqenix-charter -f charter/Dockerfile . && docker run --rm -v $PWD:/repo orqenix-charter",
    "integration": "pnpm --filter @orqenix/integration test",
    "smoke:cross-repo": "bash smoke/cross-repo-smoke.sh",
    "smoke:cross-repo:windows": "pwsh ./smoke/cross-repo-smoke.ps1",
    "lint": "pnpm -r --filter=\"./packages/*\" lint",
    "clean": "pnpm -r --filter=\"./packages/*\" clean && rm -rf node_modules",
    "pre-publish-check": "tsx scripts/pre-publish-check.ts",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && pnpm test && pnpm verify-phase-5 && changeset publish",
    "ci:publish": "pnpm build && changeset publish",
    "release:dry-run": "pnpm -r exec npm pack --dry-run",
    "release:propose": "tsx scripts/release-propose.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@swc/core"
    ],
    "overrides": {
      "protobufjs": "^7.5.8"
    }
  },
  "devDependencies": {
    "@changesets/cli": "2.27.10",
    "@changesets/changelog-github": "0.5.0",
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "turbo": "^2.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yaml": "^2.5.0"
  }
}

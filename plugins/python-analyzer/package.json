{
  "name": "@orqenix/plugin-python-analyzer",
  "version": "0.8.0-alpha.1",
  "description": "Reference code-analyzer plugin: Python code analysis via tree-sitter.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/plugin.js",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npx tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "orqenix",
    "orqenix-plugin",
    "code-analyzer",
    "python",
    "tree-sitter"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "orqenixPlugin": {
    "manifestVersion": "1.0",
    "kind": "code-analyzer",
    "compatibility": {
      "orqenix": ">=0.8.0"
    },
    "permissions": [
      "fs.read"
    ],
    "external_agent_compat": [
      "claude-code",
      "cursor"
    ],
    "sandboxMode": "separate_process",
    "tool": {
      "name": "python_analyze",
      "description": "Analyzes Python source: extracts functions, classes, imports",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          }
        },
        "required": [
          "source"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "functions": {
            "type": "array"
          },
          "classes": {
            "type": "array"
          },
          "imports": {
            "type": "array"
          }
        }
      }
    }
  },
  "devDependencies": {
    "tsup": "catalog:",
    "vitest": "catalog:",
    "typescript": "catalog:"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/milosaysyolo/Orqenix.git"
  }
}

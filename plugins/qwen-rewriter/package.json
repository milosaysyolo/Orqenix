{
  "name": "@orqenix/plugin-qwen-rewriter",
  "version": "0.8.0-alpha.1",
  "description": "Reference prompt-rewriter plugin: Qwen 2.5 7B local prompt rewriting.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/plugin.js",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npx tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "orqenix",
    "orqenix-plugin",
    "prompt-rewriter",
    "qwen",
    "local"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "orqenixPlugin": {
    "manifestVersion": "1.0",
    "kind": "prompt-rewriter",
    "compatibility": {
      "orqenix": ">=0.8.0"
    },
    "permissions": [],
    "external_agent_compat": [
      "claude-code",
      "cursor",
      "codex",
      "opencode"
    ],
    "sandboxMode": "separate_process",
    "tool": {
      "name": "qwen_rewrite",
      "description": "Rewrites a user prompt for better retrieval (Qwen 2.5 7B local)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "rewritten": {
            "type": "string"
          }
        }
      }
    }
  },
  "devDependencies": {
    "tsup": "catalog:",
    "vitest": "catalog:",
    "typescript": "catalog:"
  },
  "private": true
}
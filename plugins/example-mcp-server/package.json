{
  "name": "@orqenix/plugin-example-mcp-server",
  "version": "0.8.0-alpha.1",
  "description": "Reference mcp-server plugin: a minimal MCP server exposing one tool.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/plugin.js",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npx tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "orqenix",
    "orqenix-plugin",
    "mcp-server"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "orqenixPlugin": {
    "manifestVersion": "1.0",
    "kind": "mcp-server",
    "compatibility": {
      "orqenix": ">=0.8.0",
      "mcp": ">=0.5.0"
    },
    "permissions": [
      "scope.read"
    ],
    "external_agent_compat": [
      "claude-code",
      "cursor",
      "opencode"
    ],
    "sandboxMode": "separate_process",
    "lifecycle": {
      "activate": "./scripts/activate.mjs",
      "deactivate": "./scripts/deactivate.mjs"
    },
    "tool": {
      "name": "echo",
      "description": "Echoes input back (minimal MCP server reference)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "echoed": {
            "type": "string"
          }
        }
      }
    }
  },
  "devDependencies": {
    "tsup": "catalog:",
    "vitest": "catalog:",
    "typescript": "catalog:"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/milosaysyolo/Orqenix.git"
  }
}

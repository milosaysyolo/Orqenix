{
  "name": "@orqenix/binding-codex",
  "version": "0.8.0-alpha.1",
  "description": "Apache-2.0 Orqenix binding for ChatGPT Codex. Bridges Orqenix via GPT plugin / API.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@orqenix/binding-core": "workspace:*",
    "@orqenix/mcp-server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "keywords": [
    "orqenix",
    "binding",
    "codex",
    "chatgpt",
    "apache-2.0"
  ],
  "engines": {
    "node": ">=20.10.0"
  }
}

{
  "name": "@orqenix/core",
  "version": "0.9.0",
  "description": "Orqenix core runtime: scope, config, storage, sync engine",
  "license": "Apache-2.0",
  "author": {
    "name": "Milo Nguyen",
    "email": "milo@orqenix.dev",
    "url": "https://orqenix.dev"
  },
  "homepage": "https://orqenix.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milosaysyolo/Orqenix.git",
    "directory": "packages\\core"
  },
  "bugs": {
    "url": "https://github.com/milosaysyolo/Orqenix/issues"
  },
  "keywords": [
    "orqenix",
    "ai-agents",
    "core"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "npx rimraf dist .turbo",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test",
    "dev": "tsup --watch",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "better-sqlite3": "^11.3.0",
    "chokidar": "^4.0.0",
    "diff": "^7.0.0",
    "gray-matter": "^4.0.3",
    "isomorphic-git": "^1.27.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/diff": "^6.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "orqenix": {
    "module": "./dist/index.js"
  }
}

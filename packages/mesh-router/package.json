{
  "name": "@orqenix/mesh-router",
  "version": "0.10.0",
  "description": "Cross-transport mesh router for Orqenix Phase 6: priority-based selection, circuit breaker, sequential failover within deadline, cross-transport dedup, capability-gated inbound dispatch.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Milo Nguyen <milo@orqenix.dev> (https://orqenix.dev)",
  "homepage": "https://orqenix.dev",
    "keywords": [
    "orqenix"
  ],
  "bugs": {
    "url": "https://github.com/milosaysyolo/Orqenix/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
    "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "clean": "npx rimraf dist .tsbuildinfo",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test",
    "gate:G43": "vitest run test/G43-gate-wrapper.test.ts --reporter verbose",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@orqenix/mesh-transport-core": "workspace:*",
    "@orqenix/mesh-observability": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^2.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/milosaysyolo/Orqenix.git",
    "directory": "packages/mesh-router"
  }
}

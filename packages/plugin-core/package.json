{
  "name": "@orqenix/plugin-core",
  "version": "0.8.0-alpha.1",
  "description": "Apache-2.0 plugin architecture foundation for Orqenix. 14 plugin kinds, lifecycle, sandbox, CSF validation.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./csf": {
      "types": "./dist/csf-schema.d.ts",
      "import": "./dist/csf-schema.mjs",
      "require": "./dist/csf-schema.cjs"
    },
    "./kinds": {
      "types": "./dist/kinds/registry.d.ts",
      "import": "./dist/kinds/registry.mjs",
      "require": "./dist/kinds/registry.cjs"
    },
    "./sandbox": {
      "types": "./dist/sandbox/index.d.ts",
      "import": "./dist/sandbox/index.mjs",
      "require": "./dist/sandbox/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@vitest/ui": "^2.1.5",
    "eslint": "^9.15.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/milosaysyolo/Orqenix.git",
    "directory": "packages/plugin-core"
  },
  "homepage": "https://orqenix.dev/docs/plugin-core",
  "keywords": [
    "orqenix",
    "plugin-architecture",
    "csf",
    "canonical-skill-format",
    "sandbox",
    "apache-2.0"
  ],
  "engines": {
    "node": ">=20.10.0"
  }
}

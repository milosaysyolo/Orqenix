{
  "name": "@orqenix/kb-code",
  "version": "0.5.0",
  "description": "Orqenix kb-code package",
  "license": "Apache-2.0",
  "author": {
    "name": "Milo Nguyen",
    "email": "milo@orqenix.dev",
    "url": "https://orqenix.dev"
  },
  "homepage": "https://orqenix.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milosaysyolo/Orqenix.git",
    "directory": "packages\\kb-code"
  },
  "bugs": {
    "url": "https://github.com/milosaysyolo/Orqenix/issues"
  },
  "keywords": [
    "orqenix",
    "ai-agents",
    "memory"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test",
    "postinstall": "node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@orqenix/core": "workspace:*",
    "@orqenix/embedding-local": "workspace:*",
    "better-sqlite3": "^11.0.0",
    "web-tree-sitter": "^0.22.0",
    "tree-sitter-wasms": "^0.1.11",
    "chokidar": "^3.6.0",
    "isomorphic-git": "^1.27.0",
    "blake3-wasm": "^2.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "vitest": "^1.6.0",
    "typescript": "^5.4.0"
  }
}

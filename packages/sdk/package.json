{
  "name": "@orqenix/sdk",
  "version": "0.5.0",
  "description": "Sdk for Orqenix (Part-12)",
  "license": "Apache-2.0",
  "author": {
    "name": "Milo Nguyen",
    "email": "milo@orqenix.dev",
    "url": "https://orqenix.dev"
  },
  "homepage": "https://orqenix.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milosaysyolo/Orqenix.git",
    "directory": "packages\\sdk"
  },
  "bugs": {
    "url": "https://github.com/milosaysyolo/Orqenix/issues"
  },
  "keywords": [
    "orqenix",
    "ai-agents",
    "orchestration"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

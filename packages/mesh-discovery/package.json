{
  "name": "@orqenix/mesh-discovery",
  "version": "0.6.1",
  "description": "Mesh discovery for Orqenix Phase 6: mDNS local LAN default, explicit bootstrap.yaml, typed event lifecycle. No DHT, no public bootstrap by default.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "gate:G39": "vitest run test/G39-gate-wrapper.test.ts --reporter verbose",
    "lint:no-dht-no-relay": "tsx ../../scripts/lint/no-dht-no-relay.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . || true"
  },
  "dependencies": {
    "@orqenix/mesh-transport-core": "^0.6.0",
    "@orqenix/mesh-transport-libp2p": "^0.6.0",
    "@libp2p/mdns": "^12.0.0",
    "@multiformats/multiaddr": "^12.3.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^2.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

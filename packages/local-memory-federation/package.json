{
  "name": "@orqenix/local-memory-federation",
  "version": "0.8.0-alpha.1",
  "description": "Apache-2.0 pull-on-demand cross-project memory federation for Orqenix Workbench. Strictly opt-in per CR v8.0 ADR-E-011.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "restricted",
    "provenance": false
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "yaml": "^2.6.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@vitest/ui": "^2.1.5",
    "eslint": "^9.15.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/milosaysyolo/Orqenix.git",
    "directory": "packages/local-memory-federation"
  },
  "homepage": "https://orqenix.dev/docs/local-memory-federation",
  "keywords": [
    "orqenix",
    "memory-federation",
    "cross-project",
    "apache-2.0"
  ],
  "engines": {
    "node": ">=20.10.0"
  }
}

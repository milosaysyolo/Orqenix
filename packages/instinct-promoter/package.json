{
  "name": "@orqenix/instinct-promoter",
  "version": "0.10.0",
  "description": "Apache-2.0 instinct promoter for Orqenix. Human-in-the-loop candidate review (Promote/Reject/Customize/Defer).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npx tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@orqenix/self-learning-detection": "workspace:*",
    "@orqenix/self-learning-observer": "workspace:*",
    "@orqenix/skill-genesis": "workspace:*",
    "@orqenix/ui-primitives": "workspace:*",
    "lucide-react": "^0.475.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.15.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/milosaysyolo/orqenix.git",
    "directory": "packages/instinct-promoter"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}

{
  "name": "@orqenix/cli",
  "version": "0.9.0",
  "description": "The orqenix command-line tool",
  "license": "Apache-2.0",
  "author": {
    "name": "Milo Nguyen",
    "email": "milo@orqenix.dev",
    "url": "https://orqenix.dev"
  },
  "homepage": "https://orqenix.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milosaysyolo/Orqenix.git",
    "directory": "packages\\cli"
  },
  "bugs": {
    "url": "https://github.com/milosaysyolo/Orqenix/issues"
  },
  "keywords": [
    "orqenix",
    "ai-agents",
    "cli"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@orqenix/scope-link": "workspace:*",
    "@orqenix/workspace": "workspace:*",
    "@orqenix/audit-log": "workspace:*",
    "@orqenix/detach": "workspace:*",
    "@orqenix/migration": "workspace:*",
    "@orqenix/storage-sqlite": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^1.6.0",
    "typescript": "^5.5.0"
  },
  "bin": {
    "orqenix": "./dist/bin.js"
  }
}

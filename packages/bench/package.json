{
  "name": "@orqenix/bench",
  "version": "0.8.0-alpha.1",
  "description": "Internal performance benchmark suite for Orqenix (Phase 1-8).",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "bench": "node --expose-gc --import tsx scripts/run-all-benchmarks.mjs",
    "bench:phase": "node --expose-gc --import tsx scripts/run-phase.mjs",
    "bench:gate": "node --import tsx scripts/regression-gate.mjs",
    "bench:report": "node --import tsx scripts/generate-report.mjs"
  },
  "dependencies": {
    "@orqenix/memory-engine": "workspace:*",
    "@orqenix/plugin-core": "workspace:*",
    "@orqenix/normalization-engine": "workspace:*",
    "@orqenix/input-adapters": "workspace:*",
    "@orqenix/output-adapters": "workspace:*",
    "@orqenix/settings-registry": "workspace:*",
    "@orqenix/self-learning-observer": "workspace:*",
    "@orqenix/self-learning-detection": "workspace:*",
    "@orqenix/local-memory-federation": "workspace:*",
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "better-sqlite3": "^11.5.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": { "node": ">=20.10.0" }
}

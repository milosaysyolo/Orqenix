{
  "name": "@orqenix/self-learning-observer",
  "version": "0.9.0",
  "description": "Apache-2.0 self-learning observer for Orqenix. Captures workflow patterns (opt-out) for skill genesis.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@orqenix/memory-engine": "workspace:*",
    "@noble/hashes": "^1.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@vitest/ui": "^2.1.5",
    "eslint": "^9.15.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/milosaysyolo/Orqenix.git",
    "directory": "packages/self-learning-observer"
  },
  "keywords": [
    "orqenix",
    "self-learning",
    "observer",
    "apache-2.0"
  ],
  "engines": {
    "node": ">=20.10.0"
  }
}

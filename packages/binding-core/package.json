{
  "name": "@orqenix/binding-core",
  "version": "0.9.0",
  "description": "Orqenix binding core — platform-agnostic interfaces for agent runtime bindings",
  "license": "Apache-2.0",
  "author": "Milo Nguyen",
  "homepage": "https://orqenix.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/milosaysyolo/Orqenix.git"
  },
  "bugs": {
    "url": "https://github.com/milosaysyolo/Orqenix/issues"
  },
  "keywords": [
    "orqenix",
    "binding",
    "core",
    "apache-2.0"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "exit 0"
  },
  "dependencies": {},
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}

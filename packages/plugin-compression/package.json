{
  "name": "@orqenix/plugin-compression",
  "version": "0.10.0",
  "description": "Merged compression plugins: context, input, output",
  "license": "Apache-2.0",
  "author": {
    "name": "Milo Nguyen",
    "email": "milo@orqenix.dev",
    "url": "https://orqenix.dev"
  },
  "homepage": "https://orqenix.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milosaysyolo/Orqenix.git",
    "directory": "packages/plugin-compression"
  },
  "bugs": {
    "url": "https://github.com/milosaysyolo/Orqenix/issues"
  },
  "keywords": [
    "orqenix",
    "ai-agents",
    "plugin"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npx tsup",
    "test": "npx vitest run test/",
    "typecheck": "tsc --noEmit",
    "clean": "npx rimraf dist .turbo",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@orqenix/compress-strategies": "workspace:*",
    "@orqenix/core": "workspace:*",
    "@orqenix/smart-compression": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

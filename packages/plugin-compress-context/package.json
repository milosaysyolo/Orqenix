{
  "name": "@orqenix/plugin-compress-context",
  "version": "2.0.0-phase-5",
  "description": "Context compression plugin v2 — backed by @orqenix/smart-compression (CR v7.1 Ch.6)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".":   { "types": "./dist/index.d.ts",  "import": "./dist/index.js",  "default": "./dist/index.js" },
    "./v1": { "types": "./dist/v1.d.ts",    "import": "./dist/v1.js",    "default": "./dist/v1.js" },
    "./v2": { "types": "./dist/v2.d.ts",    "import": "./dist/v2.js",    "default": "./dist/v2.js" }
  },
  "scripts": { "build": "tsc --build", "test": "vitest run" },
  "dependencies": {
    "@orqenix/core": "workspace:*",
    "@orqenix/compress-strategies": "workspace:*",
    "@orqenix/smart-compression": "workspace:*",
    "@orqenix/hooks": "workspace:*",
    "@orqenix/telemetry": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": { "vitest": "^1.6.0", "typescript": "^5.5.0" },
  "files": ["dist", "README.md", "LICENSE"],
  "orqenix": { "phase4Compatible": true, "phase5Path": "v2" }
}

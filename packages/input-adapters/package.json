{
  "name": "@orqenix/input-adapters",
  "version": "0.10.0",
  "description": "Apache-2.0 input adapters for Orqenix normalization. 14 source formats G CSF.",
  "license": "Apache-2.0",
  "author": "Milo Nguyen <milo@orqenix.dev> (https://orqenix.dev)",
  "homepage": "https://orqenix.dev",
  "bugs": {
    "url": "https://github.com/milosaysyolo/Orqenix/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "npx rimraf dist .turbo",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@orqenix/plugin-core": "workspace:*",
    "@orqenix/normalization-engine": "workspace:*",
    "yaml": "^2.6.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "eslint": "^9.15.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/milosaysyolo/Orqenix.git",
    "directory": "packages/input-adapters"
  },
  "keywords": [
    "orqenix",
    "input-adapters",
    "csf",
    "apache-2.0"
  ],
  "engines": {
    "node": ">=20.10.0"
  }
}

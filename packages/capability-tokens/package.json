{
  "name": "@orqenix/capability-tokens",
  "version": "0.5.0-phase-5",
  "description": "Ed25519-signed capability tokens for Orqenix local-first mesh (CR v7.1 Ch.14)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".":            { "types": "./dist/index.d.ts",        "import": "./dist/index.js",        "default": "./dist/index.js" },
    "./format":     { "types": "./dist/format.d.ts",       "import": "./dist/format.js",       "default": "./dist/format.js" },
    "./signing":    { "types": "./dist/signing.d.ts",      "import": "./dist/signing.js",      "default": "./dist/signing.js" },
    "./permissions":{ "types": "./dist/permissions.d.ts",  "import": "./dist/permissions.js",  "default": "./dist/permissions.js" },
    "./revocation": { "types": "./dist/revocation.d.ts",   "import": "./dist/revocation.js",   "default": "./dist/revocation.js" },
    "./issuer":     { "types": "./dist/issuer.d.ts",       "import": "./dist/issuer.js",       "default": "./dist/issuer.js" },
    "./verifier":   { "types": "./dist/verifier.d.ts",     "import": "./dist/verifier.js",     "default": "./dist/verifier.js" }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@orqenix/core": "workspace:*",
    "@orqenix/scope-identity": "workspace:*",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "vitest": "^2.1.0",
    "typescript": "^5.6.0"
  },
  "files": ["dist", "README.md", "LICENSE"]
}

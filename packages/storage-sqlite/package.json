{
  "name": "@orqenix/storage-sqlite",
  "version": "0.5.0-phase-5",
  "description": "SQLite + sqlite-vec adapter for Orqenix KBs",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".":            { "types": "./dist/index.d.ts",       "import": "./dist/index.js",       "default": "./dist/index.js" },
    "./connection": { "types": "./dist/connection.d.ts",  "import": "./dist/connection.js",  "default": "./dist/connection.js" },
    "./migrations": { "types": "./dist/migrations.d.ts",  "import": "./dist/migrations.js",  "default": "./dist/migrations.js" },
    "./vec":        { "types": "./dist/vec.d.ts",         "import": "./dist/vec.js",         "default": "./dist/vec.js" }
  },
  "scripts": { "build": "tsc --build", "test": "vitest run" },
  "dependencies": {
    "@orqenix/core": "workspace:*",
    "better-sqlite3": "^11.1.2",
    "sqlite-vec": "^0.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "vitest": "^1.6.0",
    "typescript": "^5.5.0"
  },
  "files": ["dist", "README.md", "LICENSE"]
}

{
  "name": "@orqenix/mesh-routing",
  "version": "0.5.0",
  "description": "Cross-scope mesh query coordinator with parallel fanout + timeouts + provenance (CR v7.1 Ch.13)",
  "license": "Apache-2.0",
  "author": {
    "name": "Milo Nguyen",
    "email": "milo@orqenix.dev",
    "url": "https://orqenix.dev"
  },
  "homepage": "https://orqenix.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milosaysyolo/Orqenix.git",
    "directory": "packages\\mesh-routing"
  },
  "bugs": {
    "url": "https://github.com/milosaysyolo/Orqenix/issues"
  },
  "keywords": [
    "orqenix",
    "ai-agents",
    "mesh"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test"
  },
  "dependencies": {
    "@orqenix/core": "workspace:*",
    "@orqenix/scope-identity": "workspace:*",
    "@orqenix/capability-tokens": "workspace:*",
    "@orqenix/scope-link": "workspace:*",
    "@orqenix/provenance": "workspace:*",
    "@orqenix/hooks": "workspace:*",
    "@orqenix/storage-sqlite": "workspace:*",
    "@orqenix/telemetry": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "vitest": "^1.6.0",
    "typescript": "^5.5.0"
  }
}

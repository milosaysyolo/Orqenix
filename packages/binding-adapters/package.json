{
  "name": "@orqenix/binding-adapters",
  "version": "0.9.0",
  "description": "Apache-2.0 Orqenix platform binding adapters (aider, claude-code, cline, codex, continue, cursor, opencode). Merged from 7 individual binding-* packages.",
  "license": "Apache-2.0",
  "author": "Milo Nguyen",
  "homepage": "https://orqenix.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/milosaysyolo/Orqenix.git"
  },
  "bugs": {
    "url": "https://github.com/milosaysyolo/Orqenix/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npx tsup",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "npx vitest run tests/"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@orqenix/binding-core": "workspace:*",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "keywords": [
    "orqenix",
    "binding",
    "adapters",
    "aider",
    "claude-code",
    "cline",
    "codex",
    "continue",
    "cursor",
    "opencode",
    "mcp",
    "apache-2.0"
  ],
  "engines": {
    "node": ">=20.10.0"
  }
}

{
  "name": "@orqenix/mcp-server",
  "version": "0.8.0-alpha.1",
  "description": "Apache-2.0 Orqenix MCP Server. Exposes memory + skills + mesh as MCP tools/resources/prompts over stdio/HTTP/WebSocket.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "orqenix-mcp": "./dist/cli.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "LICENSE", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@orqenix/memory-engine": "workspace:*",
    "@orqenix/plugin-core": "workspace:*",
    "@orqenix/skill-runtime": "workspace:*",
    "@noble/hashes": "^1.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@vitest/ui": "^2.1.5",
    "eslint": "^9.15.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/milosaysyolo/Orqenix.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://orqenix.dev/docs/mcp-server",
  "keywords": [
    "orqenix",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "apache-2.0"
  ],
  "engines": {
    "node": ">=20.10.0"
  }
}

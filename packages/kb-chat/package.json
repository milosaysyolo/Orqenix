{
  "name": "@orqenix/kb-chat",
  "version": "0.5.0-phase-5",
  "description": "Chat Knowledge Base (sessions, entries, vector search, capability-gated writes)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".":            { "types": "./dist/index.d.ts",         "import": "./dist/index.js",         "default": "./dist/index.js" },
    "./schema":     { "types": "./dist/schema.d.ts",        "import": "./dist/schema.js",        "default": "./dist/schema.js" },
    "./store":      { "types": "./dist/store.d.ts",         "import": "./dist/store.js",         "default": "./dist/store.js" }
  },
  "scripts": { "build": "tsc --build", "test": "vitest run" },
  "dependencies": {
    "@orqenix/core": "workspace:*",
    "@orqenix/storage-sqlite": "workspace:*",
    "@orqenix/storage-diff": "workspace:*",
    "@orqenix/capability-tokens": "workspace:*",
    "@orqenix/scope-identity": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": { "vitest": "^1.6.0", "typescript": "^5.5.0" },
  "files": ["dist", "README.md", "LICENSE"]
}

{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "audit:dead-deps": {
      "dependsOn": [],
      "outputs": [],
      "inputs": ["packages/*/package.json", "packages/*/src/**/*.ts"]
    },
    "audit:versions": {
      "dependsOn": [],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orqenix Cross-Repo Refs",
  "type": "object",
  "required": ["version", "orqenix-pro", "consumers"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "orqenix-pro": {
      "type": "object",
      "required": ["ref", "rationale", "owner"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string" },
        "owner": { "type": "string" },
        "bump-frequency": { "type": "string" },
        "last-bumped": { "type": "string", "format": "date" },
        "last-bumped-by": { "type": "string" },
        "compatible-oss-range": { "type": "string" }
      }
    },
    "consumers": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  }
}

# Orqenix publish configuration
# This file controls how pnpm/npm interacts with the registry.
# Do NOT add auth tokens here. CI uses NPM_TOKEN from secrets.

registry=https://registry.npmjs.org/

# Scoped registries (redundant but explicit for clarity)
@orqenix:registry=https://registry.npmjs.org/

# Always require auth for publish (prevents accidental anonymous publish)
always-auth=true

# Enable SLSA provenance for all publishes
provenance=true

# Use strict SSL
strict-ssl=true

# Use a single lockfile at the workspace root
shared-workspace-lockfile=true

# Prevent installing through Yarn or npm by accident
engine-strict=true

# Save exact versions in package.json (no ^ or ~ prefix)
save-exact=true

# Hoist patterns for monorepo (pnpm-specific)
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*

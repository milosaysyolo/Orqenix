# SPDX-License-Identifier: Apache-2.0
# Per Phase 5 security policy: ignore-scripts=true is on by default for the
# entire workspace. Per-package install scripts are gated by pnpm.onlyBuiltDependencies
# in root package.json (allowlist).
ignore-scripts=true

# Use hoisted node_modules so native bindings resolve via standard require path.
# Without this, pnpm's strict isolation breaks better-sqlite3 binding lookup
# (the "Could not locate the bindings file" symptom).
node-linker=hoisted

# Prevent recursive auto-install of peer deps to avoid duplicated React copies
# (root cause of the React 19 peer-conflict class).
auto-install-peers=false

# Strict peers warns instead of fails (we audit manually via check-dep-versions).
strict-peer-dependencies=false

# Always show the binary-download URL for debugging prebuilt fetches.
prebuild-install.verbose=true

registry=https://registry.npmjs.org/
@orqenix:registry=https://registry.npmjs.org/

# Always require auth for publish
always-auth=true

# Enable SLSA provenance
# provenance=true

# Use strict SSL
strict-ssl=true

# Workspace settings
shared-workspace-lockfile=true
engine-strict=true
save-exact=true

# Hoist for shared tooling
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
